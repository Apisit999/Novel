<div class="reader-settings" role="group" aria-label="ตั้งค่าการอ่าน">
	<button class="btn" type="button" data-size="-0.1" aria-label="ลดขนาดตัวอักษร">ก−</button>
	<button class="btn" type="button" data-size="0.1" aria-label="เพิ่มขนาดตัวอักษร">ก+</button>
	<button class="btn" type="button" id="font-toggle">สลับฟอนต์</button>
</div>

<script>
	const root = document.documentElement;
	const clamp = (n: number) => Math.min(2, Math.max(0.9, n));
	document.querySelectorAll<HTMLButtonElement>('[data-size]').forEach((b) =>
		b.addEventListener('click', () => {
			const cur = parseFloat(getComputedStyle(root).getPropertyValue('--read-size')) || 1.2;
			const next = clamp(Math.round((cur + parseFloat(b.dataset.size!)) * 10) / 10);
			root.style.setProperty('--read-size', next + 'rem');
			localStorage.setItem('size', String(next));
		}),
	);
	document.getElementById('font-toggle')?.addEventListener('click', () => {
		const next = root.dataset.font === 'sans' ? 'serif' : 'sans';
		root.dataset.font = next;
		localStorage.setItem('font', next);
	});
</script>
