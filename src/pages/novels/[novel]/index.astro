---
import Base from '../../../layouts/Base.astro';
import { getNovels, getChapters, chapterSlug, chapterUrl, formatDate } from '../../../lib/novels';
import { STATUS_LABEL } from '../../../lib/site';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const novels = await getNovels();
	return Promise.all(
		novels.map(async (novel) => ({
			params: { novel: novel.id },
			props: { novel, chapters: await getChapters(novel.id) },
		})),
	);
}
const { novel, chapters } = Astro.props;
const { title, author, description, status, tags } = novel.data;
const { Content } = await render(novel);
const first = chapters[0];
---

<Base title={title} description={description}>
	<h1>{title}</h1>
	<div class="muted">โดย {author} · {STATUS_LABEL[status]} · {chapters.length} ตอน</div>
	<p>{tags.map((t) => <span class="tag">{t}</span>)}</p>
	<p>{description}</p>
	<Content />

	<p>
		{
			first && (
				<a class="btn primary" id="start-reading" href={chapterUrl(novel.id, chapterSlug(first))} data-novel={novel.id}>
					เริ่มอ่าน
				</a>
			)
		}
	</p>

	<h2>สารบัญ</h2>
	<ul class="chapter-list">
		{
			chapters.map((c) => (
				<li>
					<a href={chapterUrl(novel.id, chapterSlug(c))}>
						<span>{c.data.title}</span>
						{c.data.publishedAt && <span class="muted">{formatDate(c.data.publishedAt)}</span>}
					</a>
				</li>
			))
		}
	</ul>

	<script>
		// ถ้าเคยอ่านค้างไว้ ให้ปุ่มพาไปตอนล่าสุด
		const btn = document.getElementById('start-reading') as HTMLAnchorElement | null;
		const last = btn && localStorage.getItem(`last:${btn.dataset.novel}`);
		if (btn && last) {
			btn.href = last;
			btn.textContent = 'อ่านต่อ';
		}
	</script>
</Base>
