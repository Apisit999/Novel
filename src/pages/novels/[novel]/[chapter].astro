---
import Base from '../../../layouts/Base.astro';
import ReaderControls from '../../../components/ReaderControls.astro';
import { getNovels, getChapters, chapterSlug, chapterUrl, novelUrl } from '../../../lib/novels';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const novels = await getNovels();
	const paths = await Promise.all(
		novels.map(async (novel) => {
			const chapters = await getChapters(novel.id);
			return chapters.map((chapter, i) => ({
				params: { novel: novel.id, chapter: chapterSlug(chapter) },
				props: { novel, chapter, prev: chapters[i - 1], next: chapters[i + 1] },
			}));
		}),
	);
	return paths.flat();
}
const { novel, chapter, prev, next } = Astro.props;
const { Content } = await render(chapter);
const here = chapterUrl(novel.id, chapterSlug(chapter));
---

<Base title={`${chapter.data.title} – ${novel.data.title}`} description={novel.data.description}>
	<div class="progress" id="progress"></div>
	<p><a href={novelUrl(novel.id)}>← {novel.data.title}</a></p>
	<h1>{chapter.data.title}</h1>
	<ReaderControls />

	<article class="prose"><Content /></article>

	<nav class="chapter-nav" aria-label="เปลี่ยนตอน">
		<a class="btn" href={prev ? chapterUrl(novel.id, chapterSlug(prev)) : undefined} aria-disabled={!prev} rel="prev">← ก่อนหน้า</a>
		<a class="btn" href={novelUrl(novel.id)}>สารบัญ</a>
		<a class="btn primary" href={next ? chapterUrl(novel.id, chapterSlug(next)) : undefined} aria-disabled={!next} rel="next">ถัดไป →</a>
	</nav>

	<script define:vars={{ novelId: novel.id, here }}>
		localStorage.setItem('last:' + novelId, here);
		const bar = document.getElementById('progress');
		addEventListener(
			'scroll',
			() => {
				const max = document.documentElement.scrollHeight - innerHeight;
				bar.style.width = (max > 0 ? Math.min(100, (scrollY / max) * 100) : 0) + '%';
			},
			{ passive: true },
		);
		addEventListener('keydown', (e) => {
			const sel = e.key === 'ArrowLeft' ? 'a[rel=prev]' : e.key === 'ArrowRight' ? 'a[rel=next]' : null;
			const a = sel && document.querySelector(sel);
			if (a && a.getAttribute('href')) location.href = a.getAttribute('href');
		});
	</script>
</Base>
