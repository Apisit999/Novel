# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local ไม่ถูก commit)

# ที่อยู่เว็บ (ใช้สร้างลิงก์/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (เฟส 0.3) — ค่าสาธารณะ ปลอดภัยที่จะอยู่ในเบราว์เซอร์
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ความลับ — ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Feature flags (สวิตช์ paywall อยู่ในฐานข้อมูล: ตาราง app_settings)
SIGNUP_ENABLED=true

# ใช้กับ Supabase CLI และเทสต์ฐานข้อมูล (npm run test:db) — ห้าม commit
# SUPABASE_ACCESS_TOKEN: สร้างที่ supabase.com/dashboard/account/tokens (ใช้เสร็จแล้ว revoke)
SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD: รหัสผ่านฐานข้อมูลที่ตั้งตอนสร้างโปรเจกต์
SUPABASE_DB_PASSWORD=
